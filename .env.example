# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real value — it is committed.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string used by Prisma (see prisma.config.ts).
DATABASE_URL=

# ── Google AI (Gemini) ────────────────────────────────────────────────────────
# Server-side only — never expose this to the browser. GEMINI_API_KEY is
# accepted as an alias if an existing deployment already sets that name.
GOOGLE_AI_API_KEY=

# Model used by the portfolio chat assistant. Flash is the right default here:
# the answers are short, grounded in a fixed context, and streamed to a widget,
# so latency matters more than depth.
# Note: gemini-2.5-* is closed to new API keys and answers 404.
AI_MODEL=gemini-3.6-flash

# ── Contact form email ────────────────────────────────────────────────────────
# A Gmail app password, not your account password.
EMAIL_USER=
EMAIL_PASS=

# Where contact submissions are delivered. Defaults to eyobsmax@gmail.com.
CONTACT_EMAIL=
